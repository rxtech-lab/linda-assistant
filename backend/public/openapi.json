{
  "openapi": "3.0.0",
  "info": {
    "title": "Linda Assistant API",
    "version": "1.0.0",
    "description": "Personal assistant backend API for managing emails, tasks, chat sessions, and AI-powered agent interactions."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "updateAssigneeSchema": {
        "type": "object"
      },
      "insertAssigneeSchema": {
        "type": "object"
      },
      "sendMessageSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "image",
                    "audio",
                    "pdf",
                    "file"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "name": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "type",
                "url"
              ]
            },
            "nullable": true
          }
        },
        "required": [
          "content"
        ]
      },
      "insertChatSessionSchema": {
        "type": "object"
      },
      "resolveConfirmationSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "reject"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "insertDeviceSchema": {
        "type": "object"
      },
      "updateEmailSchema": {
        "type": "object",
        "properties": {
          "isRead": {
            "type": "boolean",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {},
            "nullable": true
          },
          "assigneeId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "insertEmailSchema": {
        "type": "object"
      },
      "updateTaskSchema": {
        "type": "object"
      },
      "insertTaskSchema": {
        "type": "object"
      },
      "presignedUrlSchema": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "contentType"
        ]
      },
      "sendMessageResponseSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "queued": {
                "type": "boolean"
              }
            },
            "required": [
              "queued"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "resolveResponseSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "confirm",
                  "reject"
                ]
              },
              "confirmationId": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "confirmationId"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "sessionSummarySchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "nullable": true
                },
                "status": {
                  "type": "string",
                  "nullable": true
                },
                "assigneeId": {
                  "type": "string",
                  "nullable": true
                },
                "createdAt": {
                  "type": "string",
                  "nullable": true
                },
                "updatedAt": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "id"
              ]
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "toolPermissionSchema": {
        "type": "object",
        "properties": {
          "toolName": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "enum": [
              "auto-confirm",
              "manual-confirm",
              "auto-reject"
            ]
          }
        },
        "required": [
          "toolName",
          "permission"
        ]
      },
      "selectAssigneeSchema": {
        "type": "object"
      },
      "selectEmailSchema": {
        "type": "object"
      },
      "selectTaskSchema": {
        "type": "object"
      },
      "insertTaskEmailSchema": {
        "type": "object"
      },
      "selectTaskEmailSchema": {
        "type": "object"
      },
      "updateChatSessionSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          },
          "assigneeId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "selectChatSessionSchema": {
        "type": "object"
      },
      "selectConfirmationSchema": {
        "type": "object"
      },
      "selectDeviceSchema": {
        "type": "object"
      },
      "taskDetailSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "chatSessions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string",
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "nullable": true
                    },
                    "updatedAt": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              },
              "emails": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "chatSessions",
              "emails"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "toolSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "defaultPermission": {
            "type": "string",
            "enum": [
              "auto-confirm",
              "manual-confirm",
              "auto-reject"
            ]
          }
        },
        "required": [
          "name",
          "description",
          "defaultPermission"
        ]
      },
      "toolsResponseSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/toolSchema"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "presignedUrlResponseSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "key"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "paginationSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "limit",
          "offset"
        ]
      },
      "listResponseSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/selectAssigneeSchema"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "total": {
                "type": "number"
              },
              "limit": {
                "type": "number"
              },
              "offset": {
                "type": "number"
              },
              "hasMore": {
                "type": "boolean"
              }
            },
            "required": [
              "total",
              "limit",
              "offset",
              "hasMore"
            ]
          }
        },
        "required": [
          "data",
          "pagination"
        ]
      },
      "detailResponseSchema": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/selectAssigneeSchema"
          }
        },
        "required": [
          "data"
        ]
      }
    },
    "responses": {
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Invalid request parameters"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Authentication required"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Access denied"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Resource not found"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "An unexpected error occurred"
                }
              }
            }
          }
        }
      }
    }
  },
