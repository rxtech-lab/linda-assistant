{
  "name": "linda-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun openapi:generate && bun db:push && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "openapi:generate": "next-openapi-gen generate",
    "test:e2e": "playwright test",
    "worker": "bun worker/index.ts 2>&1 | tee worker.log",
    "worker:dev": "bun --watch worker/index.ts 2>&1 | tee worker.log",
    "setup:e2e": "bun scripts/setup-e2e-db.ts",
    "dev:e2e": "bash scripts/dev-e2e.sh",
    "worker:e2e": "bun --env-file=.env.e2e worker/index.ts 2>&1 | tee worker.log"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3",
    "@ai-sdk/mcp": "^1.0.20",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@libsql/client": "^0.15",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@vercel/sandbox": "^1.9.0",
    "ai": "^6.0.116",
    "ajv": "^8.17.1",
    "amqplib": "^0.10.9",
    "cron-parser": "^4",
    "drizzle-orm": "^0.44",
    "drizzle-zod": "^0.7",
    "escape-html": "^1.0.3",
    "ioredis": "^5.10.1",
    "jose": "^6.1.3",
    "marked": "^17.0.3",
    "nanoid": "^5",
    "next": "16.1.6",
    "puppeteer": "^24.37.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redoc": "^2.5.2",
    "resend": "^6.9.2",
    "svix": "^1",
    "tsx": "^4.21.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@playwright/test": "^1.58.2",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "latest",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "next-openapi-gen": "^0",
    "typescript": "^6.0.2"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
